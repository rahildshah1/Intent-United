# Supabase — Intent United (template). Copy to .env and fill in real values.
# See config.example.js for the browser-side equivalent.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SERVER-ONLY. Never expose in the browser or commit a real value.
SUPABASE_SECRET_KEY=sb_secret_xxx

